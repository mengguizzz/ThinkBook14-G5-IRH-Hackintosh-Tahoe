+ state.display13AUXControllerSlot=reinterpret_cast<uintptr_t>(&c.controller);put(f.ctl,0xC30,c.lock);
+ for(unsigned n=0;n<6;++n)put(f.port,0x594+4*n,0x64010U+4*n);
